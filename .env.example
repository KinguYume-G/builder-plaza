# Copy to .env and fill in real values. Never commit .env.

# App
ENVIRONMENT=local

# GitHub OAuth (F1 Dual-Source Trust Gateway)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn (ADR-0003: IdentityProvider switches on LINKEDIN_MODE)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_MODE=simulated

# Auth
JWT_SECRET=

# Database (RDS PostgreSQL + pgvector in prod; local Postgres for dev)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/builder_plaza

# AWS (S3 uploads, Bedrock summarisation -- ADR-0002)
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

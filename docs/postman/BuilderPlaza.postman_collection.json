            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"VectorDB Proxy v2\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/projects/{{project_id}}"
          }
        },
        {
          "name": "GET /projects/{{project_id}}/repo-activity",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/projects/{{project_id}}/repo-activity" }

            "body": {
              "mode": "raw",
              "raw": "{\n  \"collab_request_id\": \"{{request_id}}\",\n  \"stars\": 5,\n  \"tags\": [\"responsive\", \"clear-communicator\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/users/{{other_user_id}}/reviews"
          }
        }
      ]
    },
    {
      "name": "Requests & Conversations (F7 Controlled DM)",

        {
          "name": "POST /projects/{{project_id}}/screenshots-upload-url",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_type\": \"image/png\"\n}",
              "options": { "raw": { "language": "json" } }

          "name": "GET /users/{{other_user_id}}/reviews",
          "request": { "method": "GET", "url": "{{base_url}}/users/{{other_user_id}}/reviews" }
        },
        {
          "name": "POST /users/{{other_user_id}}/reviews (needs an accepted request between the two users)",

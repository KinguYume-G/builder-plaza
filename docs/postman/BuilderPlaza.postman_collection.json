    {
      "name": "Growth Plaza (F4)",
      "item": [
        {
          "name": "GET /plaza",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/plaza?limit=30&offset=0" }
        },
        {
          "name": "GET /projects/{{project_id}}/growth",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/projects/{{project_id}}/growth" }
        },
        {
          "name": "POST /projects/{{project_id}}/refresh-growth",
          "request": { "method": "POST", "url": "{{base_url}}/projects/{{project_id}}/refresh-growth" }
        },
        {
          "name": "POST /internal/growth-refresh-all (shared-secret, not JWT)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "X-Internal-Token", "value": "{{internal_task_token}}" }],
            "url": "{{base_url}}/internal/growth-refresh-all"
          }
        }
      ]
    },
    {
      "name": "Matching (F5)",
      "item": [
        {
          "name": "GET /matches",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const matches = pm.response.json();",
                  "  if (matches.length > 0) pm.collectionVariables.set('match_id', matches[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{base_url}}/matches?refresh=true" }
        },
        {
          "name": "POST /matches/{{match_id}}/dismiss",
          "request": { "method": "POST", "url": "{{base_url}}/matches/{{match_id}}/dismiss" }
        },
        {
          "name": "GET /users/{{other_user_id}}/credibility-summary",
          "request": { "method": "GET", "url": "{{base_url}}/users/{{other_user_id}}/credibility-summary" }
        }
      ]
    },
    {
      "name": "Trust & Evidence (F6 / F10)",
      "item": [
        {
          "name": "GET /users/{{other_user_id}}/trust-score",
          "request": { "method": "GET", "url": "{{base_url}}/users/{{other_user_id}}/trust-score" }
        },
        {
          "name": "GET /users/{{other_user_id}}/activity-timeline",

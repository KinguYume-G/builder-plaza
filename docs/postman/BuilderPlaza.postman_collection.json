    {
      "name": "Projects (F3 Project Card)",
      "item": [
        {
          "name": "POST /projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('project_id', pm.response.json().id);",
                  "}",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"VectorDB Proxy\",\n  \"stage\": \"building\",\n  \"needs\": \"Looking for a Rust contributor for the async cache layer\",\n  \"demo_url\": \"https://example.com/demo\",\n  \"team_division\": \"One founder, one backend contributor wanted\",\n  \"repo_full_names\": [\"octocat/Hello-World\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/projects"
          }
        },
        {
          "name": "GET /projects (discovery feed)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/projects?limit=20&offset=0" }
        },
        { "name": "GET /projects/mine", "request": { "method": "GET", "url": "{{base_url}}/projects/mine" } },
        {

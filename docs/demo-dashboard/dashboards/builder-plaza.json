    {
      "type": "row",
      "title": "The actual rows \u2014 newest first",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "project_cards \u2014 newest 8",
      "description": "Segment 1: creating a card and uploading a screenshot lands here.",
      "datasource": {
        "type": "postgres",
        "uid": "bp-rds"
      },
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "select p.created_at, u.github_login as owner, p.title, p.stage, cardinality(p.screenshot_s3_keys) as shots from project_cards p join users u on u.id = p.owner_id order by p.created_at desc limit 8",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "minWidth": 95,
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "collab_requests \u2014 newest 8",
      "description": "Segment 2 sends one; segment 3 flips its state to accepted.",
      "datasource": {
        "type": "postgres",
        "uid": "bp-rds"
      },
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "select r.created_at, f.github_login as from_user, t.github_login as to_user, r.intent_type, r.state, left(r.pitch, 60) as pitch from collab_requests r join users f on f.id = r.from_user join users t on t.id = r.to_user order by r.created_at desc limit 8",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "minWidth": 95,
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "pending": {
                        "color": "orange",
                        "index": 0
                      },
                      "accepted": {
                        "color": "green",
                        "index": 1
                      },
                      "declined": {
                        "color": "red",
                        "index": 2
                      },
                      "withdrawn": {
                        "color": "text",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "messages \u2014 newest 8",
      "description": "Segment 3: a conversation only exists after a request is accepted.",
      "datasource": {
        "type": "postgres",
        "uid": "bp-rds"
      },
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "select m.created_at, u.github_login as sender, left(m.body, 80) as body from messages m join users u on u.id = m.sender_id order by m.created_at desc limit 8",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "minWidth": 95,
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "growth_posts \u2014 newest 5 AI summaries",
      "description": "Segment 1: Refresh growth writes one of these.",
      "datasource": {
        "type": "postgres",
        "uid": "bp-rds"
      },
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "select g.created_at, p.title as project, g.trigger, left(g.summary, 90) as summary from growth_posts g join project_cards p on p.id = g.project_id order by g.created_at desc limit 5",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "minWidth": 95,
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": []
      }
    }
